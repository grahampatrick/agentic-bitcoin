# Copy to .env.local and fill in to enable durable Supabase storage for the /text waitlist.
# If BOTH are absent, the waitlist falls back to a non-durable in-memory store (fine for local dev).
# The service-role key is SECRET — server-only, never expose to the browser, never commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# M10 receive side: seals recipients' receive-only wallet strings; MUST equal the bot's SECRETS_KEY
SECRETS_KEY=
NEXT_PUBLIC_SITE_URL=https://agentic-bitcoin.vercel.app

# Public site URL used for canonical/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3900

# Price feed needs no keys. Override the upstreams only for testing.
# PRICE_PRIMARY_URL=https://mempool.space/api/v1/prices
# PRICE_FALLBACK_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd

# Where the "Text Agentic Bitcoin" CTA sends people. Set at least one to replace the waitlist with the
# onboarding page (Signal number in E.164, Telegram bot username without @).
NEXT_PUBLIC_SIGNAL_NUMBER=
# M23 workspace contact rows (optional)
NEXT_PUBLIC_DISCORD_INVITE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TELEGRAM_BOT=
# M22 referral terms shown on /join/<code>; the same values as the bot's
REFERRAL_REWARD_SATS=0
REFERRAL_FRIEND_SATS=0
REFERRAL_MIN_SPEND_SATS=1000
