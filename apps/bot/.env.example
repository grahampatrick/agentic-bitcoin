# ---- surface ----
SURFACE=signal                   # signal (telegram remains as a dev-only surface)
TELEGRAM_BOT_TOKEN=              # from @BotFather (dev surface)
SIGNAL_ACCOUNT=                  # +1… the bot's own number (SURFACE=signal)
SIGNAL_DAEMON_URL=http://localhost:8080  # the daemon pins the Host header to localhost (compose shares its network)
SIGNAL_MULTI_ACCOUNT=0           # 1 only if the daemon runs without -a
SIGNAL_NOTE_TO_SELF=0            # 1 when signal-cli is LINKED to your own account: talk to the bot in Note to Self
BOT_ALLOWED_USERS=               # comma-separated user ids the bot answers, e.g. signal:+15551234567 (empty = everyone)

# Optional "select group" gate: new numbers must send this code first; empty = open to anyone who messages.
BOT_INVITE_CODE=

# ---- model ----
ANTHROPIC_API_KEY=

# ---- stores (omit both for in-memory dev) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SECRETS_KEY=                     # 32 bytes hex; encrypts per-user wallet strings and API keys; generate once, back up

# ---- dev-only shared credentials (per-user pairing via /pair and /key replaces these) ----
NWC_URL=
STRIKE_API_KEY=
BITREFILL_API_KEY=
SWEEP_TO_WALLET=0                # 1 = after a scheduled buy, Strike pays an invoice from the user's wallet
PRICE_URL=https://mempool.space/api/v1/prices

# ---- giving (M9): the operator's recipient directory, loaded at boot; see apps/bot/recipients.example.json ----
RECIPIENTS_FILE=
SHOP_FILE=                       # M12: operator catalogue, see apps/bot/shop.example.json (merchants must be recipients)
BOT_OPERATORS=                   # user ids that may /verify recipients, e.g. signal:+15551234567
SITE_URL=https://agentic-bitcoin.vercel.app

# ---- on-chain sweeps to cold storage (M8), operator LND with an onchain:read+write macaroon only ----
LND_REST_URL=
LND_MACAROON_HEX=

# ---- sats-back rewards (M13): paid from the OPERATOR's wallet under its own cap; omit to accrue without paying ----
REWARDS_NWC_URL=                 # a budgeted NWC string for the rewards wallet (never a user's)
REWARDS_DAILY_CAP_SATS=50000
REWARDS_BPS_DIRECTORY=100        # 1% on storefront purchases
REWARDS_BPS_BITREFILL=0          # stays 0 until the affiliate terms allow bitcoin payouts (OQ-16)
REWARDS_MIN_PAYOUT_SATS=100
